{
  "name": "ember-character-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "format": "prettier --write src browser-tests *.json *.ts index.html",
    "check": "prettier --check src browser-tests *.json *.ts index.html",
    "test:browser": "pnpm build && tsc --project tsconfig.browser.json && playwright test"
  },
  "dependencies": {
    "livekit-client": "^2.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
