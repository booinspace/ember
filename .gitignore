# Private sources, state, credentials, and local deployment configuration.
/.local/*
!/.local/config/
/.local/config/*
# Miku's two Strata deployments and their pinned manifests contain no credentials.
!/.local/config/deployment.strata.toml
!/.local/config/deployment.strata-mtp.toml
!/.local/config/runner.ember-strata.json
!/.local/config/runner.ember-strata-mtp.json
.cache/
data/
runtime-data/
exports/
reports/
backups/
*.zip
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example
deployment.local.toml
*.log

# Python/build/tool artifacts. uv.lock is intentionally tracked.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/
coverage.xml
.coverage

# Browser dependencies and generated assets; the pnpm lockfile is tracked.
node_modules/
